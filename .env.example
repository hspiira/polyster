# Copy this file to .env and fill in your Supabase project's own values.
# Find both under Project Settings -> API in the Supabase dashboard.
# Never commit the real .env file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Used only by scripts/verify-rls.mjs (pnpm verify:rls), never by the app.
# Deliberately NOT prefixed with VITE_ -- Vite only inlines VITE_-prefixed
# vars into the client bundle, and this one must never end up there: it's
# the direct Postgres connection string (Project Settings -> Database ->
# Connection string), which authenticates as the `postgres` role and
# bypasses RLS entirely. Keep it out of anything shipped to a browser.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
